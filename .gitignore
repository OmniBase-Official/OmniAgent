# Python
__pycache__/
*.py[cod]
*.egg-info/
# Build artifacts. Ignoring them is necessary and not sufficient: the
# tests/test_eval_workspace.py invariant walks the tree by the sandbox's
# admission rules, which prune hidden and denied paths rather than
# gitignored ones, so a stray build/lib/agent.py still fails it as a second
# reachable carrier. tests/test_wheel_completeness.py builds from a staged
# copy outside the checkout so neither directory is created here at all.
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local config / secrets
.env
.env.*
!.env.example

# Editors & OS
.vscode/
.idea/
.kilo/
*.swp
.DS_Store
Thumbs.db

# Structured run logs
*.jsonl
data/

# Local settings (profiles live in omniagent.toml, which IS committed)
omniagent.local.toml

# Throwaway venv used to rehearse CI locally
.ci-venv/

# Trained models, adapters, GGUF and the llama.cpp checkout
models/
.superpowers/

# Native offline inference core build artifacts
omniagent-core/build*/

# Scratch output from an external Bandit patch-audit tool. The suffix is a
# fresh hash on every run, so the pattern is wildcarded: pinning the one
# directory seen on 2026-10-26 would let the next run reappear untracked.
# Nothing in this repository produces these; they are ignored so `git add -A`
# cannot sweep ~1 MB of someone else's scan output into a commit.
.tmp-omnipatch-*/

# Agent scratch and leftover worktrees that live inside the checkout: pytest
# basetemps and investigation fixtures, written here because sandboxed
# sessions cannot use the AppData temp directory. Ignored so that
# "git status" can gate a measurement, per the rule added after the void run
# of 2026-10-26, and so that ruff -- which respects .gitignore -- stops
# reporting an abandoned worktree as this project failing its own gate.
.scratch/
.brief11-worktree/
.codex-worktrees/

# Local AI handoff and role prompts
/docs/pm/*-prompt.md
